<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="homeblend_asset_comp_rule" model="ir.rule">
        <field name="name">الأصول: الشركة</field>
        <field name="model_id" ref="model_homeblend_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="homeblend_budget_comp_rule" model="ir.rule">
        <field name="name">الميزانيات: الشركة</field>
        <field name="model_id" ref="model_homeblend_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="homeblend_budget_line_comp_rule" model="ir.rule">
        <field name="name">بنود الميزانية: الشركة</field>
        <field name="model_id" ref="model_homeblend_budget_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
