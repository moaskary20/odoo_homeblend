<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">homeblend.financial.report.wizard.form</field>
        <field name="model">homeblend.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="قائمة مالية">
                <group>
                    <field name="report_type"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="تصدير Excel"/>
                    <button name="action_print" type="object" string="طباعة PDF" class="btn-primary"/>
                    <button string="إغلاق" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">قائمة مالية رسمية</field>
        <field name="res_model">homeblend.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_report_financial_pdf" model="ir.actions.report">
        <field name="name">قائمة مالية</field>
        <field name="model">homeblend.financial.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">homeblend_reports.report_financial_statement</field>
        <field name="report_file">homeblend_reports.report_financial_statement</field>
        <field name="print_report_name">'قائمة مالية'</field>
    </record>
    <template id="report_financial_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="data" t-value="o._get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl">
                        <t t-call="homeblend_reports.hb_fin_report_css"/>
                        <h2 t-out="data['title']"/>
                        <p>
                            الشركة: <span t-field="o.company_id"/> —
                            من <span t-field="o.date_from"/> إلى <span t-field="o.date_to"/>
                        </p>
                        <t t-call="homeblend_reports.hb_fin_report_legend"/>
                        <t t-foreach="data['sections']" t-as="section">
                            <h3 class="hb-row-header" t-out="section['name']"/>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>الكود</th>
                                        <th>الحساب</th>
                                        <th class="text-end">الرصيد</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="section['lines']" t-as="line">
                                        <td t-out="line['code']"/>
                                        <td t-out="line['name']"/>
                                        <td t-att-class="'text-end' + (' hb-neg' if line['balance'] &lt; 0 else '')"
                                            t-out="line['balance']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </tr>
                                    <tr class="hb-row-total">
                                        <td colspan="2">⟸ إجمالي · <t t-out="section['name']"/></td>
                                        <td t-att-class="'text-end' + (' hb-neg' if section['total'] &lt; 0 else '')"
                                            t-out="section['total']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="o.report_type == 'pnl'">
                            <table class="table table-sm table-bordered">
                                <tr t-att-class="'hb-row-result-ok' if data['net'] &gt;= 0 else 'hb-row-result-bad'">
                                    <td>⟸ نتيجة · صافي النتيجة</td>
                                    <td t-att-class="'text-end' + (' hb-neg' if data['net'] &lt; 0 else '')"
                                        t-out="data['net']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </tr>
                            </table>
                        </t>
                        <t t-if="o.report_type == 'balance'">
                            <table class="table table-sm table-bordered">
                                <tr class="hb-row-total">
                                    <td>⟸ إجمالي · إجمالي الأصول</td>
                                    <td class="text-end" t-out="data['assets_total']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </tr>
                                <tr class="hb-row-total">
                                    <td>⟸ إجمالي · إجمالي الخصوم وحقوق الملكية</td>
                                    <td class="text-end" t-out="data['liab_equity_total']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </tr>
                                <tr t-if="data['difference']"
                                    t-att-class="'hb-row-result-bad' if data['difference'] else 'hb-row-result-ok'">
                                    <td>⟸ نتيجة · فرق غير متوازن</td>
                                    <td class="text-end hb-neg" t-out="data['difference']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </tr>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="view_homeblend_budget_list" model="ir.ui.view">
        <field name="name">homeblend.budget.list</field>
        <field name="model">homeblend.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="planned_total"/>
                <field name="actual_total"/>
                <field name="variance_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_homeblend_budget_form" model="ir.ui.view">
        <field name="name">homeblend.budget.form</field>
        <field name="model">homeblend.budget</field>
        <field name="arch" type="xml">
            <form class="hb-fin-report">
                <header>
                    <button name="action_open" type="object" string="اعتماد" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="إقفال" invisible="state != 'open'"/>
                    <button name="action_draft" type="object" string="إعادة مسودة" invisible="state == 'draft'"/>
                    <button name="action_export_xlsx" type="object" string="تصدير Excel"/>
                    <button name="action_print_pdf" type="object" string="طباعة PDF"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="planned_total"/>
                            <field name="actual_total"/>
                            <field name="variance_total"/>
                        </group>
                    </group>
                    <div class="hb-fin-legend alert alert-light mb-2" role="note">
                        <span class="hb-legend-item hb-legend-debit">مخطط</span>
                        <span class="hb-legend-item hb-legend-credit">انحراف</span>
                        <span class="hb-legend-item hb-legend-neg">رقم سالب (−)</span>
                    </div>
                    <field name="line_ids" class="hb-fin-report">
                        <list editable="bottom">
                            <field name="account_id"/>
                            <field name="analytic_account_id"/>
                            <field name="planned_amount" class="text-end hb-col-debit"
                                      decoration-danger="planned_amount &lt; 0"/>
                            <field name="actual_amount" class="text-end"
                                      decoration-danger="actual_amount &lt; 0"/>
                            <field name="variance_amount" class="text-end hb-col-credit"
                                      decoration-danger="variance_amount &lt; 0"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="ملاحظات"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_homeblend_budget" model="ir.actions.act_window">
        <field name="name">الميزانيات</field>
        <field name="res_model">homeblend.budget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
