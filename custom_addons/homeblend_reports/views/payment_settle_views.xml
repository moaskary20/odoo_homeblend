<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hb_payment_settle_book_list" model="ir.ui.view">
        <field name="name">homeblend.payment.settle.book.list</field>
        <field name="model">homeblend.payment.settle.book</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="state == 'matched'" decoration-danger="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="channel"/>
                <field name="direction"/>
                <field name="amount"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
                <field name="matched_payment_id" optional="hide"/>
                <field name="matched_pos_payment_id" optional="hide"/>
                <button name="action_reset_match" type="object" string="إلغاء المطابقة" invisible="state != 'matched'"/>
            </list>
        </field>
    </record>
    <record id="view_hb_payment_settle_book_form" model="ir.ui.view">
        <field name="name">homeblend.payment.settle.book.form</field>
        <field name="model">homeblend.payment.settle.book</field>
        <field name="arch" type="xml">
            <form string="سطر كشف">
                <header>
                    <button name="action_reset_match" type="object" string="إلغاء المطابقة" invisible="state != 'matched'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,matched"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="direction"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="matched_payment_id" readonly="1"/>
                            <field name="matched_pos_payment_id" readonly="1"/>
                            <field name="match_note" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hb_payment_settle_book_search" model="ir.ui.view">
        <field name="name">homeblend.payment.settle.book.search</field>
        <field name="model">homeblend.payment.settle.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <filter name="open" string="غير مسوّى" domain="[('state', '=', 'open')]"/>
                <filter name="matched" string="مسوّى" domain="[('state', '=', 'matched')]"/>
                <filter name="cash" string="نقدي" domain="[('channel', '=', 'cash')]"/>
                <filter name="bank" string="تحويل بنكي" domain="[('channel', '=', 'bank')]"/>
                <filter name="card" string="بطاقة" domain="[('channel', '=', 'card')]"/>
                <filter name="wallet" string="محفظة" domain="[('channel', '=', 'wallet')]"/>
                <group>
                    <filter name="group_channel" string="الوسيلة" context="{'group_by': 'channel'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_hb_payment_settle_book" model="ir.actions.act_window">
        <field name="name">سطور كشف التسوية</field>
        <field name="res_model">homeblend.payment.settle.book</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="action_hb_payment_settle_book_xlsx" model="ir.actions.server">
        <field name="name">تصدير Excel</field>
        <field name="model_id" ref="model_homeblend_payment_settle_book"/>
        <field name="binding_model_id" ref="model_homeblend_payment_settle_book"/>
        <field name="state">code</field>
        <field name="code">action = records.action_export_xlsx()</field>
    </record>

    <record id="view_hb_payment_settle_form" model="ir.ui.view">
        <field name="name">homeblend.payment.settle.form</field>
        <field name="model">homeblend.payment.settle</field>
        <field name="arch" type="xml">
            <form string="تسوية المدفوعات" class="hb-fin-report">
                <header>
                    <button name="action_load" type="object" string="تحديث" class="btn-primary"/>
                    <button name="action_auto_match" type="object" string="مطابقة تلقائية"/>
                    <button name="action_match_selected" type="object" string="مطابقة المحدد"/>
                    <button name="action_export_xlsx" type="object" string="تصدير Excel"/>
                    <button name="action_print_pdf" type="object" string="طباعة PDF"/>
                    <button name="action_open_book_entries" type="object" string="سطور الكشف"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="hb-fin-legend alert alert-light mb-2" role="note">
                        <span class="hb-legend-item hb-legend-result-ok">مسوّى</span>
                        <span class="hb-legend-item hb-legend-result-bad">غير مسوّى</span>
                        <span class="hb-legend-item hb-legend-debit">وارد</span>
                        <span class="hb-legend-item hb-legend-credit">صادر</span>
                        <span class="hb-legend-item hb-legend-neg">رقم سالب (−)</span>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="channel"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="include_account_payments"/>
                            <field name="include_pos_payments"/>
                            <field name="include_liquidity_moves"/>
                            <field name="include_matched_books"/>
                            <div colspan="2" class="text-muted">
                                غيّر من/إلى ثم اضغط <strong>تحديث</strong>. البيانات الحالية على السيرفر غالباً في أكتوبر 2026.
                            </div>
                            <field name="system_total"/>
                            <field name="book_total"/>
                            <field name="difference"/>
                            <field name="matched_count"/>
                            <field name="unmatched_system_count"/>
                            <field name="unmatched_book_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="حركات النظام" name="system">
                            <field name="system_line_ids" class="hb-fin-report">
                                <list editable="bottom" decoration-success="is_matched" decoration-danger="not is_matched" create="false" delete="false">
                                    <field name="selected"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="is_matched" optional="hide"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="reference" optional="show"/>
                                    <field name="channel"/>
                                    <field name="direction"
                                              decoration-info="direction == 'in'"
                                              decoration-muted="direction == 'out'"/>
                                    <field name="amount" class="text-end"
                                              decoration-danger="amount &lt; 0"/>
                                    <field name="signed_amount" optional="hide"
                                              decoration-danger="signed_amount &lt; 0"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="payment_id" optional="hide"/>
                                    <field name="pos_payment_id" optional="hide"/>
                                    <field name="journal_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="حركات الكشف" name="book">
                            <field name="book_line_ids" class="hb-fin-report">
                                <list editable="bottom" decoration-success="is_matched" decoration-danger="not is_matched" create="false" delete="false">
                                    <field name="selected"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="book_id" column_invisible="1"/>
                                    <field name="is_matched" optional="hide"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="reference" optional="show"/>
                                    <field name="channel"/>
                                    <field name="direction"
                                              decoration-info="direction == 'in'"
                                              decoration-muted="direction == 'out'"/>
                                    <field name="amount" class="text-end"
                                              decoration-danger="amount &lt; 0"/>
                                    <field name="signed_amount" optional="hide"
                                              decoration-danger="signed_amount &lt; 0"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hb_payment_settle" model="ir.actions.act_window">
        <field name="name">تسوية المدفوعات</field>
        <field name="res_model">homeblend.payment.settle</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
