<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hb_ops_report_form" model="ir.ui.view">
        <field name="name">homeblend.ops.report.form</field>
        <field name="model">homeblend.ops.report</field>
        <field name="arch" type="xml">
            <form string="تقرير محاسبي" class="hb-fin-report">
                <header>
                    <button name="action_compute" type="object" string="تحديث" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="تصدير Excel"/>
                    <button name="action_print_pdf" type="object" string="طباعة PDF"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_type" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <div class="hb-fin-legend alert alert-light mb-2" role="note">
                        <span class="hb-legend-item hb-legend-total">إجمالي</span>
                        <span class="hb-legend-item hb-legend-debit">مدين</span>
                        <span class="hb-legend-item hb-legend-credit">دائن</span>
                        <span class="hb-legend-item hb-legend-neg">رقم سالب (−)</span>
                    </div>
                    <field name="line_ids" readonly="1" class="hb-fin-report">
                        <list create="false" delete="false"
                              decoration-warning="is_total"
                              decoration-bf="is_total"
                              decoration-danger="is_negative and is_total">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="is_total" column_invisible="1"/>
                            <field name="is_negative" column_invisible="1"/>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="partner_id" optional="show"/>
                            <field name="account_id" optional="show"/>
                            <field name="debit" class="text-end hb-col-debit"
                                      decoration-danger="debit &lt; 0"/>
                            <field name="credit" class="text-end hb-col-credit"
                                      decoration-danger="credit &lt; 0"/>
                            <field name="balance" class="text-end"
                                      decoration-danger="balance &lt; 0"/>
                            <field name="residual" class="text-end" optional="show"
                                      decoration-danger="residual &lt; 0"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hb_ops_receivables" model="ir.actions.act_window">
        <field name="name">الذمم المدينة</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'receivables'}</field>
    </record>
    <record id="action_hb_ops_payables" model="ir.actions.act_window">
        <field name="name">الذمم الدائنة</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'payables'}</field>
    </record>
    <record id="action_hb_ops_cashflow" model="ir.actions.act_window">
        <field name="name">التدفقات النقدية</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'cashflow'}</field>
    </record>
    <record id="action_hb_ops_taxes" model="ir.actions.act_window">
        <field name="name">الضرائب</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'taxes'}</field>
    </record>
    <record id="action_hb_ops_income" model="ir.actions.act_window">
        <field name="name">تفصيل الإيرادات</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'income'}</field>
    </record>
    <record id="action_hb_ops_expense" model="ir.actions.act_window">
        <field name="name">تفصيل المصروفات</field>
        <field name="res_model">homeblend.ops.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'expense'}</field>
    </record>
</odoo>
