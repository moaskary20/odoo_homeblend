<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_hb_statement_pdf" model="ir.actions.report">
        <field name="name">قائمة حسابات Home Blend</field>
        <field name="model">homeblend.account.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">homeblend_reports.report_hb_statement</field>
        <field name="report_file">homeblend_reports.report_hb_statement</field>
        <field name="print_report_name">(object.name or 'قائمة حسابات')</field>
    </record>

    <template id="report_hb_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl">
                        <t t-call="homeblend_reports.hb_fin_report_css"/>
                        <h2 t-out="o.name"/>
                        <p>
                            الشركة: <span t-field="o.company_id"/> —
                            من <span t-field="o.date_from"/> إلى <span t-field="o.date_to"/>
                        </p>
                        <t t-call="homeblend_reports.hb_fin_report_legend"/>
                        <p style="font-size:11px;margin-top:-8px;">الأسهم ⟸ توضّح اتجاه الإجمالي والنتيجة (RTL)</p>

                        <t t-if="o.report_type == 'trial'">
                            <p>
                                إجمالي آخر المدة مدين: <span t-field="o.total_closing_debit"/> —
                                إجمالي آخر المدة دائن: <span t-field="o.total_closing_credit"/> —
                                الفرق: <span t-field="o.difference"/> —
                                <t t-if="o.is_balanced">متوازن</t>
                                <t t-else="">غير متوازن</t>
                            </p>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>البيان</th>
                                        <th>الكود</th>
                                        <th>الطبيعة</th>
                                        <th class="text-end hb-th-debit">أول المدة مدين</th>
                                        <th class="text-end hb-th-credit">أول المدة دائن</th>
                                        <th class="text-end hb-th-debit">الحركة مدين</th>
                                        <th class="text-end hb-th-credit">الحركة دائن</th>
                                        <th class="text-end hb-th-debit">آخر المدة مدين</th>
                                        <th class="text-end hb-th-credit">آخر المدة دائن</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids" t-as="line"
                                        t-att-class="(
                                            'hb-row-header' if line.line_kind == 'header'
                                            else 'hb-row-result-bad' if line.line_kind == 'result' and line.is_negative
                                            else 'hb-row-result-ok' if line.line_kind == 'result'
                                            else 'hb-row-total' if line.line_kind == 'total' or line.is_total
                                            else None
                                        )">
                                        <td t-out="line.name"/>
                                        <td t-out="line.code or ''"/>
                                        <td t-att-class="(
                                            'hb-nature-debit' if line.nature == 'مدين'
                                            else 'hb-nature-credit' if line.nature == 'دائن'
                                            else None
                                        )" t-out="line.nature or ''"/>
                                        <td t-att-class="'text-end hb-td-debit' + (' hb-neg' if line.opening_debit &lt; 0 else '')"
                                            t-out="line.opening_debit" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end hb-td-credit' + (' hb-neg' if line.opening_credit &lt; 0 else '')"
                                            t-out="line.opening_credit" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end hb-td-debit' + (' hb-neg' if line.period_debit &lt; 0 else '')"
                                            t-out="line.period_debit" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end hb-td-credit' + (' hb-neg' if line.period_credit &lt; 0 else '')"
                                            t-out="line.period_credit" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end hb-td-debit' + (' hb-neg' if line.closing_debit &lt; 0 else '')"
                                            t-out="line.closing_debit" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end hb-td-credit' + (' hb-neg' if line.closing_credit &lt; 0 else '')"
                                            t-out="line.closing_credit" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-else="">
                            <t t-if="o.report_type == 'income'">
                                <p>
                                    مجمل ربح النشاط: <span t-field="o.activity_profit"/> —
                                    صافي الربح: <span t-field="o.net_profit"/> —
                                    نسبة التكلفة %: <span t-field="o.cost_ratio"/> —
                                    نسبة المصروفات العمومية %: <span t-field="o.overhead_ratio"/>
                                </p>
                            </t>
                            <t t-if="o.report_type == 'balance'">
                                <p>
                                    إجمالي الأصول: <span t-field="o.assets_total"/> —
                                    الخصوم وحقوق الشركاء: <span t-field="o.liabilities_equity_total"/> —
                                    صافي الربح: <span t-field="o.net_profit"/> —
                                    الفرق: <span t-field="o.difference"/> —
                                    <t t-if="o.is_balanced">متوازن</t>
                                    <t t-else="">غير متوازن</t>
                                </p>
                            </t>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>البيان</th>
                                        <th>الكود</th>
                                        <th class="text-end">السنة</th>
                                        <th class="text-end">السنة السابقة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids" t-as="line"
                                        t-att-class="(
                                            'hb-row-header' if line.line_kind == 'header'
                                            else 'hb-row-result-bad' if line.line_kind == 'result' and line.is_negative
                                            else 'hb-row-result-ok' if line.line_kind == 'result'
                                            else 'hb-row-total' if line.line_kind == 'total' or line.is_total
                                            else None
                                        )">
                                        <td t-out="line.name"/>
                                        <td t-out="line.code or ''"/>
                                        <td t-att-class="'text-end' + (' hb-neg' if line.amount &lt; 0 else '')"
                                            t-out="line.amount" t-options="{'widget': 'float', 'precision': 2}"/>
                                        <td t-att-class="'text-end' + (' hb-neg' if line.amount_compare &lt; 0 else '')"
                                            t-out="line.amount_compare" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
