<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_track" model="ir.ui.view">
        <field name="name">sale.order.form.track</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_track" type="object" string="تتبع الطلب" invisible="state not in ('sale','done')"/>
            </xpath>
            <xpath expr="//field[@name='tenant_id']" position="after">
                <field name="track_state"/>
            </xpath>
        </field>
    </record>
</odoo>
