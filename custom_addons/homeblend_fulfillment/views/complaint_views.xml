<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_homeblend_complaint_list" model="ir.ui.view">
        <field name="name">homeblend.complaint.list</field>
        <field name="model">homeblend.complaint</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'open'" editable="bottom">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="notes" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_homeblend_complaint_form" model="ir.ui.view">
        <field name="name">homeblend.complaint.form</field>
        <field name="model">homeblend.complaint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="تفاصيل الشكوى"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_homeblend_complaint_search" model="ir.ui.view">
        <field name="name">homeblend.complaint.search</field>
        <field name="model">homeblend.complaint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="مفتوحة" name="open_c" domain="[('state', '=', 'open')]"/>
                <filter string="مغلقة" name="done_c" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="المستأجر" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_homeblend_complaint" model="ir.actions.act_window">
        <field name="name">شكاوى المستأجرين</field>
        <field name="res_model">homeblend.complaint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open_c': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">كل شكوى تخفض تقييم المستأجر ورضا العملاء تلقائياً</p>
        </field>
    </record>
</odoo>
