<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_homeblend_order_track" model="ir.sequence">
        <field name="name">تتبع طلب</field>
        <field name="code">homeblend.order.track</field>
        <field name="prefix">TR/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="ir_cron_order_track_delayed" model="ir.cron">
        <field name="name">Home Blend: طلبات متأخرة وتحصيل</field>
        <field name="model_id" ref="model_homeblend_order_track"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_delayed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
