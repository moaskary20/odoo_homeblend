<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_artcasa_product_label" model="report.paperformat">
        <field name="name">ملصق منتج Art Casa</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_artcasa_product_label" model="ir.actions.report">
        <field name="name">ملصق منتج Art Casa</field>
        <field name="model">artcasa.product.label.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">artcasa_operations.report_artcasa_product_label</field>
        <field name="report_file">artcasa_operations.report_artcasa_product_label</field>
        <field name="print_report_name">'ملصقات Art Casa'</field>
        <field name="paperformat_id" ref="paperformat_artcasa_product_label"/>
    </record>

    <template id="report_artcasa_product_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.basic_layout">
                    <div class="page" dir="rtl">
                        <style>
                            .ac-label-page { overflow: hidden; }
                            .ac-label {
                                float: right;
                                width: 48%;
                                height: 68mm;
                                border: 1px dashed #8a8a8a;
                                padding: 4mm 5mm;
                                margin: 0 0 4mm 2%;
                                box-sizing: border-box;
                                page-break-inside: avoid;
                            }
                            .ac-brand {
                                font-size: 11px;
                                letter-spacing: 1px;
                                color: #5a3d2e;
                                margin: 0 0 2px;
                            }
                            .ac-name {
                                font-size: 15px;
                                font-weight: 700;
                                line-height: 1.25;
                                margin: 0 0 2px;
                            }
                            .ac-meta {
                                font-size: 11px;
                                color: #444;
                                margin: 0 0 4px;
                            }
                            .ac-codes {
                                width: 100%;
                            }
                            .ac-codes td { vertical-align: middle; padding: 0; }
                            .ac-barcode { max-width: 100%; height: 16mm; }
                            .ac-qr { width: 22mm; height: 22mm; }
                            .ac-code {
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                                margin-top: 2px;
                            }
                        </style>
                        <div class="ac-label-page">
                            <t t-foreach="wizard._iter_labels()" t-as="label">
                                <div class="ac-label">
                                    <div class="ac-brand" t-out="label['company']"/>
                                    <div class="ac-name" t-out="label['name']"/>
                                    <div class="ac-meta">
                                        <t t-if="label['brand']">
                                            <span t-out="label['brand']"/>
                                            <t t-if="label['lot']"> · </t>
                                        </t>
                                        <t t-if="label['lot']">
                                            تشغيلة: <span t-out="label['lot']"/>
                                        </t>
                                        <t t-if="label['price']">
                                            <br/>السعر:
                                            <span t-out="label['price']" t-options="{'widget': 'monetary', 'display_currency': label['currency']}"/>
                                        </t>
                                    </div>
                                    <table class="ac-codes">
                                        <tr>
                                            <td>
                                                <img class="ac-barcode" t-att-src="label['barcode_src']"/>
                                                <div class="ac-code" t-out="label['code']"/>
                                            </td>
                                            <td style="width:24mm;text-align:center;">
                                                <img class="ac-qr" t-att-src="label['qr_src']"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
