<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_artcasa_barcode_inventory_form" model="ir.ui.view">
        <field name="name">artcasa.barcode.inventory.form</field>
        <field name="model">artcasa.barcode.inventory</field>
        <field name="arch" type="xml">
            <form string="جرد بالباركود">
                <header>
                    <button name="action_apply" type="object" string="اعتماد الجرد" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>جرد المخزن بالماسح</h1>
                    </div>
                    <group>
                        <group>
                            <field name="_barcode_scanned" widget="barcode_handler"/>
                            <field name="location_id"/>
                            <field name="barcode_input" placeholder="امسح أو اكتب الباركود ثم أضف"/>
                            <button name="action_scan_input" type="object" string="إضافة الصنف" class="btn-primary"/>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="barcode"/>
                            <field name="qty_on_hand"/>
                            <field name="qty_counted"/>
                            <field name="difference" decoration-danger="difference &lt; 0"
                                   decoration-success="difference &gt; 0"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_artcasa_barcode_inventory" model="ir.actions.act_window">
        <field name="name">جرد بالباركود</field>
        <field name="res_model">artcasa.barcode.inventory</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_artcasa_barcode_inventory_form"/>
    </record>
</odoo>
