<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_artcasa_split" model="ir.ui.view">
        <field name="name">account.move.form.artcasa.split</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="artcasa_split_role" invisible="not artcasa_split_role"/>
                <field name="artcasa_project_id" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="artcasa_split_source_id" invisible="not artcasa_split_source_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
