<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_homeblend_document_form_purchase" model="ir.ui.view">
        <field name="name">homeblend.document.form.purchase</field>
        <field name="model">homeblend.document</field>
        <field name="inherit_id" ref="homeblend_dms.view_homeblend_document_form"/>
        <field name="arch" type="xml">
            <field name="invoice_id" position="after">
                <field name="purchase_order_id"/>
            </field>
        </field>
    </record>
    <record id="view_homeblend_document_list_purchase" model="ir.ui.view">
        <field name="name">homeblend.document.list.purchase</field>
        <field name="model">homeblend.document</field>
        <field name="inherit_id" ref="homeblend_dms.view_homeblend_document_list"/>
        <field name="arch" type="xml">
            <field name="invoice_id" position="after">
                <field name="purchase_order_id" optional="show"/>
            </field>
        </field>
    </record>
    <record id="action_homeblend_purchase_documents" model="ir.actions.act_window">
        <field name="name">مستندات المشتريات</field>
        <field name="res_model">homeblend.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('document_type', '=', 'purchase')]</field>
        <field name="context">{'default_document_type': 'purchase'}</field>
    </record>
    <record id="view_purchase_order_form_documents" model="ir.ui.view">
        <field name="name">purchase.order.form.purchase.documents</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_purchase_documents" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="purchase_document_count" widget="statinfo" string="مستندات"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
