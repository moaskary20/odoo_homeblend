<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_artcasa_supplier" model="ir.ui.view">
        <field name="name">res.partner.form.artcasa.supplier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="homeblend_base.view_partner_form_homeblend"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_quality_score']" position="after">
                <field name="supplier_on_time_rate"/>
                <field name="supplier_late_po_count"/>
            </xpath>
        </field>
    </record>
    <record id="view_company_form_artcasa_margin" model="ir.ui.view">
        <field name="name">res.company.form.artcasa.margin</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="homeblend_base.view_company_form_homeblend"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_artcasa']" position="after">
                <field name="artcasa_margin_include_tax" invisible="not is_artcasa"/>
            </xpath>
        </field>
    </record>
</odoo>
