<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="homeblend_tenant.PaymentScreenDueReceived" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="after">
            <div t-if="selectedPaymentLine" class="hb-received" dir="rtl">
                <div class="hb-received-label">المبلغ المستلم من العميل</div>
                <div class="hb-received-row">
                    <input class="hb-received-input"
                           type="text"
                           inputmode="decimal"
                           dir="rtl"
                           autocomplete="off"
                           placeholder="0.00"
                           t-att-value="hbReceivedAmount"
                           t-on-focus="onReceivedFocus"
                           t-on-blur="onReceivedBlur"
                           t-on-input="onReceivedInput"/>
                    <span class="hb-received-currency" t-esc="pos.currency.symbol or 'ج.م.'"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
