<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons" class="btn btn-secondary btn-lg border-0 flex-shrink-0 hb-pos-action-btn"
                    t-on-click="() => this.clickContract()">
                <t t-if="currentOrder?.tenant_contract_id">
                    <span t-esc="currentOrder.tenant_contract_id.name"/>
                    <t t-if="currentOrder.tenant_contract_id.payment_term_id">
                        <small class="d-block" t-esc="currentOrder.tenant_contract_id.payment_term_id.name"/>
                    </t>
                </t>
                <t t-else="">العقد</t>
            </button>
            <button t-if="!props.showRemainingButtons" class="btn btn-secondary btn-lg border-0 flex-shrink-0 hb-pos-action-btn"
                    t-on-click="() => this.clickPaperInvoice()">
                <t t-if="currentOrder?.paper_invoice_filename" t-esc="currentOrder.paper_invoice_filename"/>
                <t t-else="">فاتورة ورقية</t>
            </button>
        </xpath>
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-att-class="buttonClass" t-on-click="() => this.clickContract()">
                <i class="fa fa-file-text-o me-1"/>
                <t t-if="currentOrder?.tenant_contract_id" t-esc="currentOrder.tenant_contract_id.name"/>
                <t t-else="">العقد</t>
            </button>
            <button t-att-class="buttonClass" t-on-click="() => this.clickPaperInvoice()">
                <i class="fa fa-upload me-1"/>
                <t t-if="currentOrder?.paper_invoice_filename" t-esc="currentOrder.paper_invoice_filename"/>
                <t t-else="">فاتورة ورقية</t>
            </button>
        </xpath>
    </t>
    <t t-name="point_of_sale.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="attributes">
            <attribute name="class">set-partner btn btn-secondary btn-lg lh-lg flex-shrink-0</attribute>
        </xpath>
        <xpath expr="//div[hasclass('text-truncate')]" position="attributes">
            <attribute name="class">text-action</attribute>
        </xpath>
    </t>
</templates>
