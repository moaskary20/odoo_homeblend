<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_hb_barcode" model="ir.ui.view">
        <field name="name">product.template.form.hb.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hb_print_barcode" type="object"
                        class="oe_stat_button" icon="fa-barcode"
                        invisible="not barcode and not hb_barcode_image">
                    <div class="o_stat_info">
                        <span class="o_stat_text">طباعة باركود</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="الباركود" name="hb_barcode">
                    <group>
                        <group string="بيانات الباركود">
                            <field name="barcode"/>
                            <field name="default_code"/>
                            <button name="action_hb_generate_barcode_image" type="object"
                                    string="توليد / تحديث صورة الباركود"
                                    class="btn-primary" icon="fa-refresh"/>
                            <button name="action_hb_print_barcode" type="object"
                                    string="طباعة الباركود"
                                    class="btn-secondary" icon="fa-print"
                                    invisible="not hb_barcode_image"/>
                        </group>
                        <group string="صورة الباركود للطباعة">
                            <field name="hb_barcode_image" widget="image"
                                     filename="hb_barcode_image_filename"
                                     options="{'size': [420, 120]}"/>
                            <field name="hb_barcode_image_filename" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_homeblend_product_barcode_wizard_form" model="ir.ui.view">
        <field name="name">homeblend.product.barcode.wizard.form</field>
        <field name="model">homeblend.product.barcode.wizard</field>
        <field name="arch" type="xml">
            <form string="توليد باركودات المنتجات">
                <group>
                    <field name="only_missing"/>
                    <field name="result_message" invisible="not result_message"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="توليد الباركودات"
                            class="btn-primary" invisible="result_message"/>
                    <button string="إغلاق" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_homeblend_product_barcode_wizard" model="ir.actions.act_window">
        <field name="name">توليد باركودات المنتجات</field>
        <field name="res_model">homeblend.product.barcode.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_hb_generate_barcode_image_server" model="ir.actions.server">
        <field name="name">توليد صورة الباركود</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_hb_generate_barcode_image()</field>
    </record>
</odoo>
