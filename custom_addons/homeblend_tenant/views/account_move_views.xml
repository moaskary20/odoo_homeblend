<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tenant" model="ir.ui.view">
        <field name="name">account.move.form.tenant</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="tenant_id"/>
                <field name="is_commission_invoice" invisible="1"/>
                <field name="commission_amount" invisible="not is_commission_invoice"/>
                <field name="commission_invoice_id" readonly="1"/>
                <field name="homeblend_qr_payload" invisible="state != 'posted'" widget="CopyClipboardChar"/>
            </xpath>
        </field>
    </record>
</odoo>
