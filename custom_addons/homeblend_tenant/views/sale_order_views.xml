<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_tenant" model="ir.ui.view">
        <field name="name">sale.order.form.tenant</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="tenant_id"/>
                <field name="tenant_contract_id" readonly="1"/>
                <field name="commission_percent" readonly="1"/>
                <field name="commission_base" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
