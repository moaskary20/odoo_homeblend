<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_homeblend_qr" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='qrcode']" position="after">
            <div id="homeblend_invoice_barcode" t-if="o.name and o.name != '/' and o.move_type in ('out_invoice', 'out_refund')" class="mt-2">
                <strong>باركود الفاتورة</strong>
                <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('Code128', o.name, 360, 70, 0)"
                     style="display:block;max-width:280px;height:48px;" alt="invoice barcode"/>
                <div t-out="o.name"/>
            </div>
            <div id="homeblend_qr" t-if="o.homeblend_qr_payload and not o.l10n_eg_qr_code" class="mt-2">
                <strong>QR Code</strong>
                <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', o.homeblend_qr_payload, 130, 130, 0)"
                     style="display:block;max-width:130px;"/>
            </div>
        </xpath>
    </template>

    <template id="report_invoice_pos_rtl" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-set='lang']" position="attributes">
            <attribute name="t-value">o._hb_pos_invoice_lang()</attribute>
        </xpath>
    </template>
</odoo>
