<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tenant_contract_comp_rule" model="ir.rule">
        <field name="name">عقود المستأجر: الشركة</field>
        <field name="model_id" ref="model_homeblend_tenant_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sale_order_tenant_user_rule" model="ir.rule">
        <field name="name">مبيعات المستأجر: بياناته فقط</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('homeblend_base.group_tenant_user'))]"/>
        <field name="domain_force">['|', ('tenant_id', '=', user.partner_id.id), ('tenant_id.child_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="account_move_tenant_user_rule" model="ir.rule">
        <field name="name">فواتير المستأجر: بياناته فقط</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('homeblend_base.group_tenant_user'))]"/>
        <field name="domain_force">[('tenant_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="contract_tenant_user_rule" model="ir.rule">
        <field name="name">عقود المستأجر: عقده فقط</field>
        <field name="model_id" ref="model_homeblend_tenant_contract"/>
        <field name="groups" eval="[(4, ref('homeblend_base.group_tenant_user'))]"/>
        <field name="domain_force">[('tenant_id', '=', user.partner_id.id)]</field>
    </record>
</odoo>
