<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_homeblend" model="ir.ui.view">
        <field name="name">res.partner.form.homeblend</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Home Blend" name="homeblend_tenant">
                    <group>
                        <group>
                            <field name="is_tenant"/>
                            <field name="commercial_register"/>
                            <field name="tax_id_number"/>
                            <field name="credit_limit_amount"/>
                            <field name="credit_limit" groups="account.group_account_invoice"/>
                            <field name="tenant_score"/>
                        </group>
                        <group>
                            <field name="responsible_ids" widget="many2many_tags"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group string="الفروع" invisible="not is_tenant">
                        <field name="branch_ids" nolabel="1" colspan="2" context="{'default_parent_id': id, 'default_type': 'delivery'}">
                            <list>
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="city"/>
                                <field name="street"/>
                            </list>
                        </field>
                    </group>
                    <group string="الحسابات البنكية">
                        <field name="bank_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="bank_id"/>
                                <field name="acc_number"/>
                                <field name="acc_holder_name"/>
                            </list>
                        </field>
                    </group>
                    <field name="guarantee_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
                <page string="المورد" name="homeblend_vendor" invisible="supplier_rank &lt;= 0">
                    <group>
                        <group>
                            <field name="supplier_lead_days"/>
                            <field name="supplier_quality_score"/>
                        </group>
                    </group>
                    <field name="vendor_product_ids">
                        <list editable="bottom">
                            <field name="product_tmpl_id"/>
                            <field name="product_id" optional="show"/>
                            <field name="min_qty"/>
                            <field name="price"/>
                            <field name="delay"/>
                            <field name="date_start" optional="hide"/>
                            <field name="date_end" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
