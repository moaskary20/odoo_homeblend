<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_homeblend" model="ir.module.category">
        <field name="name">HomeBlend ERP</field>
        <field name="sequence">20</field>
    </record>
    <record id="res_groups_privilege_homeblend" model="res.groups.privilege">
        <field name="name">HomeBlend</field>
        <field name="category_id" ref="module_category_homeblend"/>
    </record>
    <record id="group_homeblend_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_homeblend"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_homeblend_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_homeblend"/>
        <field name="implied_ids" eval="[(4, ref('group_homeblend_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_tenant_user" model="res.groups">
        <field name="name">Tenant Portal User</field>
    </record>
</odoo>
