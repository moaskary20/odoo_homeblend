<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_homeblend_payslip_list" model="ir.ui.view">
        <field name="name">homeblend.payslip.list</field>
        <field name="model">homeblend.payslip</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross"/>
                <field name="net"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_homeblend_payslip_form" model="ir.ui.view">
        <field name="name">homeblend.payslip.form</field>
        <field name="model">homeblend.payslip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="اعتماد" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="مدفوعة" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="wage"/>
                            <field name="allowances"/>
                            <field name="other_earnings"/>
                            <field name="insurance_base"/>
                            <field name="insurance_employee_rate"/>
                            <field name="insurance_employer_rate"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="النتيجة">
                        <group>
                            <field name="gross"/>
                            <field name="insurance_employee"/>
                            <field name="insurance_employer"/>
                        </group>
                        <group>
                            <field name="tax_amount"/>
                            <field name="net"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="ملاحظات"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_homeblend_payslip" model="ir.actions.act_window">
        <field name="name">قسائم الرواتب</field>
        <field name="res_model">homeblend.payslip</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
