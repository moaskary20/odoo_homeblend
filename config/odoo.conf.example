[options]
admin_passwd = CHANGE_ME
db_host = localhost
db_port = 5432
db_user = odoo
db_password = CHANGE_ME
list_db = True
db_maxconn = 64
http_interface = 0.0.0.0
http_port = 8069
gevent_port = 8072
addons_path = /path/to/odoo/addons,/path/to/odoo_homeblend/custom_addons
data_dir = /path/to/odoo_homeblend/data
logfile = /path/to/odoo_homeblend/logs/odoo.log
log_level = info
workers = 0
max_cron_threads = 1
proxy_mode = False
without_demo = False
